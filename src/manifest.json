{
  "manifest_version": 3,
  "name": "30% Off EVERYTHING",
  "version": "1.8",
  "description": "A Black Friday novelty for your browser: 30% off every website you visit. Black Friday only.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["banner.css", "images/*", "fonts/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
