{
  "manifest_version": 3,
  "name": "30% Off EVERYTHING",
  "version": "1.3",
  "description": "Internet Super Saver.",
  "permissions": [
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Activate Overlay"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["script.js"]
    }
  ]
}
